# ── Database (MongoDB Atlas) ───────────────────────────────
# Atlas → Connect → Drivers → copy connection string, then add db name:
# DATABASE_URL=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/studyq?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/studyq?retryWrites=true&w=majority
# If you get "unable to verify the first certificate" (antivirus SSL scan), dev only:
# MONGODB_TLS_INSECURE=true

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-prod

# ── Google Gemini AI ──────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Flask ─────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1

# ── Upload limits ─────────────────────────────────────────
MAX_CONTENT_LENGTH_MB=10
