# ── Database ──────────────────────────────────────────────
# Neon PostgreSQL example:
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/studyq?sslmode=require
DATABASE_URL=postgresql://localhost/studyq

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-prod

# ── Google Gemini AI ──────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Flask ─────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1

# ── Upload limits ─────────────────────────────────────────
MAX_CONTENT_LENGTH_MB=10
